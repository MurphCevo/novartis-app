        </mxCell>
        <mxCell id="lane-vendors" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" value="&lt;b&gt;VENDORS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Vendors support the final step: distributing approved content across channels. They depend on smooth handoffs from upstream teams.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="250" y="140" as="geometry" />
        </mxCell>
        <mxCell id="lane-agency" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" value="&lt;b&gt;CREATIVE AGENCY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Agencies handle creative execution when work is outsourced. They produce copy, designs, and assets based on briefs and require clear guidance to deliver on brand.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="180" x="250" y="270" as="geometry" />
        </mxCell>
        <mxCell id="lane-marketing" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" value="&lt;b&gt;MARKETING &amp;&lt;br&gt;EXECUTION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;The marketing team is the central orchestrator. They plan, create, and deliver campaigns, balancing time, cost, and quality across fragmented tools.&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="180" x="250" y="420" as="geometry" />
