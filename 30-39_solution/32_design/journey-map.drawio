        </mxCell>
        <mxCell id="stage-publishing" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;PUBLISHING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Releasing approved assets across channels (e.g. SFMC, Oncore, publisher portals). Coordinating with vendors and ensuring correct formatting.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="1560" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage-reporting" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;REPORTING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Tracking campaign performance using dashboards, analytics, and engagement data. Feeding insights back into planning for future campaigns.&lt;/font&gt;" vertex="1">
