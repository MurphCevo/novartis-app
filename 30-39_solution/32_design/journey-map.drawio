        <mxCell id="lane-reviewers" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" value="&lt;b&gt;REVIEWERS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Medical, Legal, and Regulatory (MLR) reviewers evaluate all content for compliance. Work is essential but often manual and overloaded, leading to bottlenecks.&lt;/font&gt;" vertex="1">
