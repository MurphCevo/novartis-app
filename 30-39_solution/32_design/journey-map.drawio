        </mxCell>
        <mxCell id="okr-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#B8860B;fontStyle=1;fontSize=12;" value="&lt;b&gt;OKR&lt;/b&gt;" vertex="1">
