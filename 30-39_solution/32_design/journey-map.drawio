        <mxCell id="okr-1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;Objective 1: Streamline the E2E content supply chain&lt;/b&gt;&lt;br&gt;Key result: Reduce new asset/campaign creation from 12 weeks to 6 weeks" vertex="1">
          <mxGeometry height="40" width="450" x="320" y="5" as="geometry" />
        </mxCell>
        <mxCell id="okr-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;Objective 2: Reduce reliance on 3rd parties for campaign and asset creation&lt;/b&gt;&lt;br&gt;Key result: Reduce external production spend by 50% YoY OR &gt;50% of all campaigns/assets created using generative AI" vertex="1">
          <mxGeometry height="40" width="550" x="780" y="5" as="geometry" />
        </mxCell>
        <mxCell id="okr-3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;Objective 3: Sustain or better quality of content&lt;/b&gt;&lt;br&gt;Key result: Increase average engagement rates (CTR/time on site, depending on channel) by 5% YoY" vertex="1">
          <mxGeometry height="40" width="500" x="1340" y="5" as="geometry" />
        </mxCell>
        <mxCell id="okr-4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;Objective 4: Improve employee experience across the content supply chain&lt;/b&gt;&lt;br&gt;Key result: ESAT &gt;4 out of 5 measured annually" vertex="1">
          <mxGeometry height="40" width="450" x="1850" y="5" as="geometry" />
        </mxCell>
        <mxCell id="stage-planning" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;PLANNING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Defining campaign objectives, target audiences, and overall strategy. Creating briefs and aligning stakeholders before content work begins.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="320" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage-copy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;COPY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Drafting and refining campaign messaging, adapting content for different channels, and preparing references for Compliance.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="630" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage-design" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;DESIGN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Designing visual assets (emails, CRMs, banners, print), formatting content for different platforms, and preparing files for submission.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="940" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stage-compliance" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;COMPLIANCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Reviewing content for medical, legal, and regulatory accuracy. Submitting reference packs, managing revisions, and ensuring approvals.&lt;/font&gt;" vertex="1">
