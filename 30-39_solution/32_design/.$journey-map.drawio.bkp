  <diagram id="journey-map" name="Marketing Content Supply Chain Journey Map">
    <mxGraphModel dx="2800" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="4000" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title-1" value="&lt;b&gt;Marketing Content Supply Chain — Journey Map&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#FFFFFF;fillColor=#1B3A6B;strokeColor=none;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="title-2" value="NOVARTIS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#FFFFFF;fillColor=#1B3A6B;strokeColor=none;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- ==================== OKR HEADER ROW ==================== -->
        <mxCell id="okr-header" value="&lt;b&gt;OKR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#B8860B;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="60" height="30" as="geometry" />
        </mxCell>

        <mxCell id="okr-1" value="&lt;b&gt;Objective 1: Streamline the E2E content supply chain&lt;/b&gt;&lt;br&gt;Key result: Reduce new asset/campaign creation from 12 weeks to 6 weeks" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="5" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="okr-2" value="&lt;b&gt;Objective 2: Reduce reliance on 3rd parties for campaign and asset creation&lt;/b&gt;&lt;br&gt;Key result: Reduce external production spend by 50% YoY OR &gt;50% of all campaigns/assets created using generative AI" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="780" y="5" width="550" height="40" as="geometry" />
        </mxCell>
        <mxCell id="okr-3" value="&lt;b&gt;Objective 3: Sustain or better quality of content&lt;/b&gt;&lt;br&gt;Key result: Increase average engagement rates (CTR/time on site, depending on channel) by 5% YoY" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1340" y="5" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="okr-4" value="&lt;b&gt;Objective 4: Improve employee experience across the content supply chain&lt;/b&gt;&lt;br&gt;Key result: ESAT &gt;4 out of 5 measured annually" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fillColor=none;strokeColor=none;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1850" y="5" width="450" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== STAGE HEADERS ==================== -->
        <mxCell id="stage-planning" value="&lt;b&gt;PLANNING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Defining campaign objectives, target audiences, and overall strategy. Creating briefs and aligning stakeholders before content work begins.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage-copy" value="&lt;b&gt;COPY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Drafting and refining campaign messaging, adapting content for different channels, and preparing references for Compliance.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage-design" value="&lt;b&gt;DESIGN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Designing visual assets (emails, CRMs, banners, print), formatting content for different platforms, and preparing files for submission.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="940" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage-compliance" value="&lt;b&gt;COMPLIANCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Reviewing content for medical, legal, and regulatory accuracy. Submitting reference packs, managing revisions, and ensuring approvals.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1250" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage-publishing" value="&lt;b&gt;PUBLISHING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Releasing approved assets across channels (e.g. SFMC, Oncore, publisher portals). Coordinating with vendors and ensuring correct formatting.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="60" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stage-reporting" value="&lt;b&gt;REPORTING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Tracking campaign performance using dashboards, analytics, and engagement data. Feeding insights back into planning for future campaigns.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1870" y="60" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== SWIM LANE LABELS (Left) ==================== -->
        <mxCell id="lane-vendors" value="&lt;b&gt;VENDORS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Vendors support the final step: distributing approved content across channels. They depend on smooth handoffs from upstream teams.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lane-agency" value="&lt;b&gt;CREATIVE AGENCY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Agencies handle creative execution when work is outsourced. They produce copy, designs, and assets based on briefs and require clear guidance to deliver on brand.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="270" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lane-marketing" value="&lt;b&gt;MARKETING &amp;&lt;br&gt;EXECUTION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;The marketing team is the central orchestrator. They plan, create, and deliver campaigns, balancing time, cost, and quality across fragmented tools.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="420" width="180" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lane-reviewers" value="&lt;b&gt;REVIEWERS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Medical, Legal, and Regulatory (MLR) reviewers evaluate all content for compliance. Work is essential but often manual and overloaded, leading to bottlenecks.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A6B;fontColor=#FFFFFF;strokeColor=#1B3A6B;fontSize=10;verticalAlign=top;spacingTop=5;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="590" width="180" height="120" as="geometry" />
        </mxCell>

